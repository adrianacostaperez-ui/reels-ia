{
  "name": "reels-ia",
  "version": "0.1.0",
  "private": true,
  "description": "Vídeos verticales con Blender, Remotion y React",
  "scripts": {
    "dev": "remotion studio src/blender-eye/index.tsx --port=3100",
    "typecheck": "tsc --noEmit",
    "compositions": "remotion compositions src/blender-eye/index.tsx",
    "render": "node scripts/render_blender_eye.mjs",
    "still": "remotion still src/blender-eye/index.tsx BlenderEyeQualityTest out/blender-eye/preview.png --frame=75",
    "eye:studio": "remotion studio src/blender-eye/index.tsx --port=3100 --no-open",
    "eye:render": "node scripts/render_blender_eye.mjs",
    "eye:check": "bash blender/eye-quality/run.sh validate"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@remotion/cli": "4.0.537",
    "@remotion/three": "4.0.537",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.537",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "typescript": "7.0.2"
  }
}
