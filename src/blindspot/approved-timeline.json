    {
      "sourceStart": 39.14,
      "sourceNextCueOrEnd": 42.34,
      "videoStart": 43.14,
      "videoNextCueOrEnd": 46.34,
      "text": "Porque tu cerebro completa esa zona con lo que tiene alrededor."
    },
    {
      "sourceStart": 42.34,
      "sourceNextCueOrEnd": 44.1,
      "videoStart": 46.34,
      "videoNextCueOrEnd": 48.1,
      "text": "En esta prueba, completa el fondo."
