    {
      "sourceStart": 26.41,
      "sourceNextCueOrEnd": 28.61,
      "videoStart": 30.41,
      "videoNextCueOrEnd": 32.61,
      "text": "El que lleva la información hacia el cerebro."
    },
    {
      "sourceStart": 28.61,
      "sourceNextCueOrEnd": 31.22,
      "videoStart": 32.61,
      "videoNextCueOrEnd": 35.22,
      "text": "Esa pequeña zona es tu punto ciego."
