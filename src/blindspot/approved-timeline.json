    {
      "sourceStart": 10.92,
      "sourceNextCueOrEnd": 12.16,
      "videoStart": 14.92,
      "videoNextCueOrEnd": 16.16,
      "text": "El punto sigue ahí."
    },
    {
      "sourceStart": 12.16,
      "sourceNextCueOrEnd": 17.81,
      "videoStart": 16.16,
      "videoNextCueOrEnd": 21.81,
      "text": "Pero, a esa distancia, su imagen cae justo en una zona de tu ojo que no detecta luz."
