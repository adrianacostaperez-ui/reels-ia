    {
      "sourceStart": 31.22,
      "sourceNextCueOrEnd": 34.38,
      "videoStart": 35.22,
      "videoNextCueOrEnd": 38.38,
      "text": "Cuando la imagen del punto cae ahí, no se genera señal."
    },
    {
      "sourceStart": 34.38,
      "sourceNextCueOrEnd": 37.41,
      "videoStart": 38.38,
      "videoNextCueOrEnd": 41.41,
      "text": "Por eso puedes dejar de verlo aunque siga delante de ti."
