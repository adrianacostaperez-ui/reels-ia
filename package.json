{
  "name": "reels-ia",
  "version": "0.1.0",
  "private": true,
  "description": "Vídeos verticales con imágenes, clips y Remotion",
  "scripts": {
    "dev": "remotion studio src/eye-2-5d/index.tsx --port=3100",
    "typecheck": "tsc --noEmit",
    "compositions": "REMOTION_BROWSER_EXECUTABLE=/usr/bin/chromium remotion compositions src/eye-2-5d/index.tsx",
    "render": "node scripts/render_eye_25d.mjs",
    "still": "node scripts/render_eye_25d.mjs --stills",
    "eye:studio": "remotion studio src/blender-eye/index.tsx --port=3100 --no-open",
    "eye:render": "node scripts/render_blender_eye.mjs",
    "eye:check": "bash blender/eye-quality/run.sh validate",
    "eye25d:render": "node scripts/render_eye_25d.mjs",
    "eye25d:check": "python scripts/validate_eye_25d.py"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@remotion/cli": "4.0.537",
    "@remotion/three": "4.0.537",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.537",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "typescript": "7.0.2"
  }
}
